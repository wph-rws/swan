# Normaliseer regeleindes: LF in de repository
* text=auto

*.f90 text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.md text eol=lf
*.swn text eol=lf

# Windows-scripts behouden CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaire/meetdata niet aanpassen
*.ele -text
*.node -text
*.dep -text
*.bot -text
