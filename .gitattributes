# Normalise line endings: LF in the repository
* text=auto

*.f90 text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.md text eol=lf
*.swn text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Leave binary and measured data alone
*.ele -text
*.node -text
*.dep -text
*.bot -text

# The operational so-rp input is a verification reference: the recorded
# results were produced with exactly these bytes, including CRLF.
# uitvoerpunten.par defines the 135 points over which the wet-point
# statistics are computed.
/so-rp_swan/par/uitvoerpunten.par -text
/so-rp_swan/par/swan2wtz/*.csv -text
