# Normaliseer regeleindes: LF in de repository
* text=auto

*.f90 text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.md text eol=lf
*.swn text eol=lf

# Windows-scripts behouden CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaire/meetdata niet aanpassen
*.ele -text
*.node -text
*.dep -text
*.bot -text

# Operationele so-rp-invoer is een verificatiereferentie: de vastgelegde
# resultaten zijn met exact deze bytes geproduceerd, inclusief CRLF.
# uitvoerpunten.par definieert de 135 punten waarover de natte-puntstatistiek
# wordt berekend.
/so-rp_swan/par/uitvoerpunten.par -text
/so-rp_swan/par/swan2wtz/*.csv -text
