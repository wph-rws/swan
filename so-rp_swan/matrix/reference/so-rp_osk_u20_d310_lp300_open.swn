PROJ 'so-rp' '0001' 'SWAN model voor het scaloost randpalen model'

MODE STATIONARY TWODIMENSIONAL

SET LEVEL = 3 MAXERR = 2 CDCAP=0.00275 INRHOG=0 NAUTICAL

CGRID CURVILINEAR 248 577 EXCE 0. 0. CIRCLE MDC=36  FLOW=0.03 FHIGH=1.0
READ  COORD 1. 'so-rp/so-rp.rgf' IDLA=3 NHEDF=7 FORMAT '(10X,5F12.3)'

INP  BOTTOM CURVILINEAR 0. 0. 249 578 EXCE -99999.
READ BOTTOM 1. 'so-rp/scaloost_rp.bot.recht' IDLA=3 NHEDF=0

WIND 20 310

BOUND SHAPESPEC JONSWAP 3.3 PEAK DSPR POWER

BOUND SEGMENT IJ 218 65 29 65 CON PAR 3.65 7.41 310 30.0
BOUND SEGMENT IJ 28 66 28 71 CON PAR 3.65 7.41 310 30.0

GEN3    KOMEN
WCAP    KOMEN   DELTA=1
BREAK   CONST  ALPHA=1.0 GAMMA=0.73
FRIC    JONSWAP CFJON=0.038
QUAD	IQUAD=2
TRIAD	ITRIAD=1 TRFAC=0.8 CUTFR=2.5

NUMERIC STOPC DABS=0.00  DREL=0.01  CURVAT=0.001  NPNTS=98.0 STAT MXITST=40  ALFA=0.01               

OBST TRANS 0.387 LINE 36856 402237.37 37103.5 404548
OBST TRANS 0.387 LINE 39100 407050 39670 408200
OBST TRANS 0.387 LINE 39852 408640 39827 409966

#BLOCK 'COMPGRID' NOHEAD 'dat/so-rp.mat' LAYOUT 3 &
#       XP YP BOTLEV HSIG TPS RTP TMM10 TM01 DIR DSPR DHS DRTM01

POINTS 'locaties'   FILE  'par/uitvoerpunten.par'
 TABLE  'locaties'  HEAD  'dat/uitvoerpunten.tab' &
 XP YP DEP HSIG RTP TPS TMM10 TM01 TM02 DIR DSPR WLEN DISS DHS DRTM01 QB HSWELL WIND WATLEV
 
SPECOUT  'locaties' SPEC1D ABSOLUTE 'dat/uitvoerpunten.sp1'
 
TEST 1 0
COMPUTE
STOP
