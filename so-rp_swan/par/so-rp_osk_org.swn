$ Standalone Scaloost/Roompot case derived from the BSS/HMC so-rp_swan setup.
$ Test condition from Run_so-rp_swan.sh:
$ wind WSN_ORG m/s from WR_ORG deg, water level NAP __SIGNED_LEVEL__ m, __OSK_LABEL__ barrier.
$ BG2 regression boundary: Hs=HS_ORG_BG2 m, Tp=TP_ORG_BG2 s.
PROJ 'scaloost_rp' '0001'

SET LEVEL=WST_ORG MAXERR=2 NAUTICAL

CGRID CURVILINEAR 248 577 EXCE 0. 0. CIRCLE 36 0.03 1.00
READ COORD 1. 'GRID' IDLA=3 NHEDF=7 FORMAT '(10X,5F12.3)'

INP BOTTOM CURVILINEAR 0. 0. 249 578 EXCE -99999.
READ BOTTOM 1. 'DEPTH' IDLA=3 NHEDF=0

WIND WSN_ORG.0 WR_ORG.0

BOUND SHAPESPEC JONSWAP 3.3 PEAK DSPR DEGREES
BOUND SEGMENT IJ 46 67 220 67 CON PAR HS_ORG_BG2 TP_ORG_BG2 WR_ORG.0 30.0

BREAKING 1. 0.73
FRICTION JONSWAP CFJON=0.067
TRIAD URSLIM=0.01
LIM URSELL=10 QB=1.0
NUM ACCUR 0.01 0.01 0.01 98 STAT MXITST=50 ALFA=0.01 LIMITER=0.1

OBST TRANS GOLFTR_OSK LINE 36856 402237.37 37103.5 404548
OBST TRANS GOLFTR_OSK LINE 39100 407050 39670 408200
OBST TRANS GOLFTR_OSK LINE 39852 408640 39827 409966

BLOCK 'COMPGRID' NOHEAD 'scaloost_rp.mat' LAYOUT 3 &
    XP YP PER TM01 TM02 WLEN DEPTH HSIGN DIR WIND
POINTS 'locaties' FILE 'uitvoerpunten.par'
TABLE 'locaties' HEAD 'uitvoerpunten.tab' &
    XP YP DEP HS PER TM01 TM02 RTP DIR DSPR FSPR DHSIGN
SPECOUT 'locaties' SPEC1D RELATIVE 'uitvoerpunten.sp1'
SPECOUT 'locaties' SPEC1D ABSOLUTE 'uitvoerpunten.sp2'

TEST 1 0
COMPUTE
STOP
