# Build directories (CMake out-of-source builds)
build/
build-*/

# Fortran build artifacts
*.mod
*.o
*.a

# SWAN runtime output
Errfile*
PRINT*
norm_end
swaninit
two_cases.tbl

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editors
*.swp
.vscode/

# Operational so-rp/Voordelta case: local and large (data + binaries), not in git.
/so-rp_swan/*

# The verification tooling and the text input it needs do belong in git:
# without those files the condition matrix cannot be reproduced. The heavy
# data (grids, executables, run output) stays out.
!/so-rp_swan/matrix/
!/so-rp_swan/comparison/
!/so-rp_swan/par/
/so-rp_swan/matrix/runs-validation*/
/so-rp_swan/matrix/runs/
/so-rp_swan/comparison/bin/
/so-rp_swan/comparison/source/

# The provenance of the 41.31 reference build is the audit trail behind the
# physics comparison. `build-*/` above would catch that directory by mistake.
!/so-rp_swan/comparison/build-info/

# Pinned upstream source and build for the delta gate (a path without hyphens:
# upstream switch.pl loops forever on a path with a hyphen in it).
/.upstream/
