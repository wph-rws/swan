+
+subroutine ADD_PROJECTED(FIRST, LAST)
+   INTEGER, INTENT(IN) :: FIRST, LAST
+   INTEGER :: ID
+   INTEGER(INT32) :: MASK
+   REAL :: X1, Y1, X2, Y3, X6, Y7, B2, B3, B6, B7, FXY1, FXY2, XY, YX
+
+   !$OMP SIMD PRIVATE(X1, Y1, X2, Y3, X6, Y7, B2, B3, B6, B7, FXY1, FXY2, XY, YX, MASK)
+   DO ID = FIRST, LAST
+      X1 = MERGE(CGO(IS,1), 0., st_kc(1).GT.1) * GX(ID)
+      Y1 = MERGE(CGO(IS,1), 0., st_kc(1).GT.1) * GY(ID)
+      X2 = MERGE(CGO(IS,2), 0., st_kc(2).GT.1) * GX(ID)
+      Y3 = MERGE(CGO(IS,3), 0., st_kc(3).GT.1) * GY(ID)
+      X6 = MERGE(CGO(IS,6), 0., st_kc(6).GT.1) * GX(ID)
+      Y7 = MERGE(CGO(IS,7), 0., st_kc(7).GT.1) * GY(ID)
+      B2 = AC2(ID,IS,IND2) * 2.0*X2
+      B3 = AC2(ID,IS,IND3) * 2.0*Y3
+      B6 = AC2(ID,IS,IND6) * 0.5*X6
+      B7 = AC2(ID,IS,IND7) * 0.5*Y7
+      FXY1 = 1.5*X1 + 1.5*Y1
+!     Preserve both orders of addition. Select by bits so the compiler
+!     can do the selection for several directions in one instruction.
+      XY = B2 - B6 + B3 - B7
+      YX = B3 - B7 + B2 - B6
+      MASK = MERGE(NOT(0_INT32), 0_INT32, Y1.GT.X1)
+      FXY2 = TRANSFER(MERGE_BITS(TRANSFER(XY, 0_INT32), TRANSFER(YX, 0_INT32), MASK), 0.)
+      IMATRA(ID,IS) = IMATRA(ID,IS) + FXY2
+      IMATDA(ID,IS) = IMATDA(ID,IS) + FXY1
+      TRAC0(ID,IS,1) = TRAC0(ID,IS,1) - FXY2
+      TRAC1(ID,IS,1) = TRAC1(ID,IS,1) + FXY1
+   END DO
+end subroutine ADD_PROJECTED
