+real(c_double) function fft_test_eps()
+   character(len=40) :: txt
+   integer :: n, st
+   real(c_double), save :: eps = 0.0_c_double
+   logical, save :: done = .false.
+   if (.not. done) then
+      call get_environment_variable('SWAN_FFT_EPS', txt, n, st)
+      if (st == 0 .and. n > 0) read (txt, *) eps
+      done = .true.
+   end if
+   fft_test_eps = eps
+end function fft_test_eps
