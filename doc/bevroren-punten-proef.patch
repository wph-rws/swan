@@ -11135,4 +11177,48 @@ SUBROUTINE SWCOMP (AC1        ,AC2        ,&
                   RETURN
                end subroutine SETUP2D
 
+!  PROTOTYPE: mark grid points whose solution has stopped moving. A point
+!  qualifies only when it AND all four neighbours changed less than FREEZE_TOL
+!  in the last iteration. Without the neighbour condition a skipped point would
+!  stay frozen forever, because the convergence test would then be measuring
+!  its own frozen state; the neighbours are what let information thaw it.
+   SUBROUTINE BUILD_FREEZE_MASK (DELHS, DEP2, KGRPNT)
+      USE swan_computational_grid, ONLY: MXC, MYC, MCGRD
+      USE swan_physical_settings, ONLY: DEPMIN
+      USE M_CONVERGENCE_SHARED, ONLY: FREEZE_TOL, FREEZE_MASK
+
+      REAL, INTENT(IN)    :: DELHS(MCGRD), DEP2(MCGRD)
+      INTEGER, INTENT(IN) :: KGRPNT(MXC,MYC)
+
+      LOGICAL, ALLOCATABLE :: QUIET(:,:)
+      INTEGER :: IX, IY, INDX
+
+      IF (.NOT.ALLOCATED(FREEZE_MASK)) ALLOCATE(FREEZE_MASK(MCGRD))
+      FREEZE_MASK = .FALSE.
+      ALLOCATE(QUIET(MXC,MYC))
+      QUIET = .FALSE.
+
+      DO IY = 1, MYC
+         DO IX = 1, MXC
+            INDX = KGRPNT(IX,IY)
+            IF ( INDX.LE.1 ) CYCLE
+            IF ( DEP2(INDX).LE.DEPMIN ) CYCLE
+            QUIET(IX,IY) = DELHS(INDX) .LE. FREEZE_TOL
+         END DO
+      END DO
+
+      DO IY = 2, MYC-1
+         DO IX = 2, MXC-1
+            IF ( .NOT.QUIET(IX,IY) ) CYCLE
+            IF ( .NOT.QUIET(IX-1,IY) ) CYCLE
+            IF ( .NOT.QUIET(IX+1,IY) ) CYCLE
+            IF ( .NOT.QUIET(IX,IY-1) ) CYCLE
+            IF ( .NOT.QUIET(IX,IY+1) ) CYCLE
+            FREEZE_MASK(KGRPNT(IX,IY)) = .TRUE.
+         END DO
+      END DO
+
+      DEALLOCATE(QUIET)
+   END SUBROUTINE BUILD_FREEZE_MASK
+
 end module swan_computation
