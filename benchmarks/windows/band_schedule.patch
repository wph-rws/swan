+module swan_sweep_bands
+!
+!     How the threads of the structured sweep share the grid rows (OpenMP
+!     without MPI; a choice of this fork, upstream has only the row pipeline).
+!
+!     Upstream deals the rows out one by one (SCHEDULE(STATIC,1)): thread t
+!     takes rows t, t+N, t+2N, ... and waits, point by point, until the point
+!     of the row before it is done. Every row a thread reads was then just
+!     written by another core. In the band schedule every thread takes a
+!     contiguous band of rows instead and goes through it column by column
+!     in the direction of the sweep: all rows of the band in one column, then
+!     the next column. The band after it in the row direction of the sweep
+!     may compute a column once this band has finished that column. A thread
+!     then reads rows of another core only at the edge of its band.
+!
+!     Why every point sees the same values as in the row pipeline: SWOMPU
+!     reads the action density AC2 (and the Hs of COMPDA) of the stencil
+!     points only upwind in both grid directions, up to three points away
+!     (st_kc 2, 3, 6, 7, 8 and 9, also for the S&L scheme, which reads the
+!     other stencil points only from AC1, the previous time level). Those
+!     values must be the new ones of this sweep. A point upwind in the same
+!     row lies in an earlier column of the same band; a point upwind in the
+!     same column lies earlier in that column of the band, or in a band
+!     before it, which has finished the column. The points downwind (the
+!     end of the row in a domain that repeats in x) must still be old, and
+!     are: they lie in a later column of the band, or in a band after it,
+!     which cannot pass this column before the band itself. The diagonal
+!     points with one index upwind and one downwind are not read from AC2,
+!     which is also why the row pipeline, where they can be old or new,
+!     gives the same output for every number of threads.
+!
+!     The bands are sized by the number of wet points in their rows, the
+!     points where SWOMPU does the work. "blocks:H" deals out bands of H
+!     rows cyclically instead (H = 1 is the row pipeline with a column
+!     counter in place of the lock per point).
+!
+!     The environment variable SWAN_SWEEP_SCHEDULE chooses: "rows" for the
+!     upstream row pipeline, "bands" (the default) or "blocks:H". The
+!     schedule only applies with more than one thread, in a build without
+!     MPI and in a two-dimensional run; otherwise the row pipeline is used.
+!
+   implicit none(type, external)
+   private
+
+   integer, parameter, public :: SCHEDULE_ROWS = 0
+   integer, parameter, public :: SCHEDULE_BANDS = 1
+   integer, parameter, public :: SCHEDULE_BLOCKS = 2
+
+!     one cache line per band counter, so that the counters of two bands do
+!     not share a line
+   integer, parameter, public :: BAND_PAD = 16
+
+   public :: sweep_schedule_from_environment, plan_sweep_bands
+
+contains
+
+subroutine sweep_schedule_from_environment(schedule, block_rows)
+   integer, intent(out) :: schedule, block_rows
+
+   character(len=32) :: value
+   integer :: status, iostat
+
+   schedule = SCHEDULE_BANDS
+   block_rows = 0
+   call get_environment_variable('SWAN_SWEEP_SCHEDULE', value, status=status)
+   if (status /= 0) return
+   if (value == 'rows') then
+      schedule = SCHEDULE_ROWS
+   else if (value(1:7) == 'blocks:') then
+      read (value(8:), *, iostat=iostat) block_rows
+      if (iostat == 0 .and. block_rows >= 1) schedule = SCHEDULE_BLOCKS
+   end if
+end subroutine sweep_schedule_from_environment
+
+!     Divide the rows iy_first, iy_first+row_step, ..., iy_last of a sweep
+!     into bands: band k covers the rows band_first(k) to band_last(k) with
+!     step row_step (no rows when band_first(k) lies beyond band_last(k)).
+subroutine plan_sweep_bands(schedule, block_rows, nthreads, iy_first, &
+   iy_last, row_step, ix_first, ix_last, wet, nband, band_first, band_last)
+   integer, intent(in) :: schedule, block_rows, nthreads
+   integer, intent(in) :: iy_first, iy_last, row_step, ix_first, ix_last
+   logical, intent(in) :: wet(:,:)
+   integer, intent(out) :: nband
+   integer, intent(out) :: band_first(:), band_last(:)
+
+   integer :: nrow, irow, iy, k, ix_low, ix_high
+   integer(kind=8) :: total, cumulative
+
+   nrow = (iy_last - iy_first)/row_step + 1
+   if (schedule == SCHEDULE_BLOCKS) then
+      nband = (nrow + block_rows - 1)/block_rows
+      do k = 1, nband
+         band_first(k) = iy_first + (k-1)*block_rows*row_step
+         band_last(k) = iy_first + (min(k*block_rows, nrow) - 1)*row_step
+      end do
+      return
+   end if
+
+   ix_low = min(ix_first, ix_last)
+   ix_high = max(ix_first, ix_last)
+   total = 0
+   do irow = 1, nrow
+      iy = iy_first + (irow-1)*row_step
+      total = total + count(wet(ix_low:ix_high,iy))
+   end do
+
+   nband = nthreads
+   k = 1
+   band_first(1) = iy_first
+   cumulative = 0
+   do irow = 1, nrow
+      iy = iy_first + (irow-1)*row_step
+      cumulative = cumulative + count(wet(ix_low:ix_high,iy))
+      if (k < nband .and. irow < nrow .and. &
+         cumulative*nband >= int(k,8)*total) then
+         band_last(k) = iy
+         k = k + 1
+         band_first(k) = iy + row_step
+      end if
+   end do
+   band_last(k) = iy_last
+!     bands left without rows
+   do k = k+1, nband
+      band_first(k) = iy_last + row_step
+      band_last(k) = iy_last
+   end do
+end subroutine plan_sweep_bands
+
+end module swan_sweep_bands
