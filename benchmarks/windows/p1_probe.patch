+MODULE p1_probe
+!  test build only: where the threads of the sweep spend their time
+   IMPLICIT NONE
+   REAL(8) :: TACC(8,0:63) = 0D0, TMARK(8,0:63) = -1D0
+CONTAINS
+   SUBROUTINE PBEG (K)
+      INTEGER, INTENT(IN) :: K
+      INTEGER :: T
+      REAL(8), EXTERNAL :: OMP_GET_WTIME
+      INTEGER, EXTERNAL :: OMP_GET_THREAD_NUM
+      T = OMP_GET_THREAD_NUM()
+      IF (TMARK(K,T).LT.0D0) TMARK(K,T) = OMP_GET_WTIME()
+   END SUBROUTINE PBEG
+   SUBROUTINE PEND (K)
+      INTEGER, INTENT(IN) :: K
+      INTEGER :: T
+      REAL(8), EXTERNAL :: OMP_GET_WTIME
+      INTEGER, EXTERNAL :: OMP_GET_THREAD_NUM
+      T = OMP_GET_THREAD_NUM()
+      IF (TMARK(K,T).GE.0D0) THEN
+         TACC(K,T) = TACC(K,T) + OMP_GET_WTIME() - TMARK(K,T)
+         TMARK(K,T) = -1D0
+      END IF
+   END SUBROUTINE PEND
+   SUBROUTINE PREPORT (N)
+      INTEGER, INTENT(IN) :: N
+      INTEGER :: T
+      OPEN (UNIT=977, FILE='p1_probe.txt', STATUS='REPLACE')
+      WRITE (977,'(A)') 'thread lockwait sweeploop endbarrier master region'
+      DO T = 0, N-1
+         WRITE (977,'(I3,5F12.4)') T, TACC(1:5,T)
+      END DO
+      CLOSE (977)
+   END SUBROUTINE PREPORT
+END MODULE p1_probe
 
